#!/usr/bin/nu

use bf

# Setup and install nginx
def main [] {
    # add www user
    bf user add www

    # get nginx version and install with dependencies
    cd /tmp
    let version = bf fs read NGINX_BUILD
    bf write $"Installing nginx v($version)."
    bf pkg install [
        "ca-certificates"
        $"nginx=($version)"
        $"nginx-mod-http-brotli=($version)"
    ]

    # install the zstd module if this version of Alpine has it (it was added in Alpine 3.20)
    # use a simulated install rather than `apk search`, which also finds packages in tagged repositories (e.g. edge)
    # that cannot be installed alongside this version of nginx
    let zstd = $"nginx-mod-http-zstd=($version)"
    if (({ ^apk --no-cache add --simulate $zstd } | bf handle --code-only) == 0) {
        bf write "Installing nginx zstd module."
        bf pkg install [ $zstd ]
    } else {
        bf write warn "The nginx zstd module is not available for this version of Alpine."
    }

    # save nginx version to build log
    bf build add Nginx $version

    # clear default nginx configuration and directories
    let conf_d = "/etc/nginx/conf.d"
    let http_d = "/etc/nginx/http.d"
    bf write "Cleaning up default nginx configuration and files."
    rm --force --recursive $conf_d $http_d /var/www/*

    # create nginx directories
    bf write "Creating nginx directories."
    mkdir /run/nginx
    mkdir /var/lib/nginx
    mkdir $http_d
    ln -s $http_d $conf_d # older builds of Nginx use conf.d instead of http.d

    # link root directory
    bf write "Linking www directories."
    let www = "/www"
    let localhost = "/var/www/localhost"
    bf write $"Linking ($www) to ($localhost)."
    ln -s $www $localhost

    # add bf-nginx module to config
    bf config use_mod bf-nginx
}
