#======================================================================================================================
# NGINX Configuration
#======================================================================================================================

user                                www www;
worker_processes                    auto;

error_log                           <% bf-env NGINX_ERROR_LOG %>;

include                             modules/*.conf;

events {
    worker_connections              1024;
}

http {


    #======================================================================================================================
    # Basic
    #======================================================================================================================

    include                         mime.types;
    default_type                    application/octet-stream;
    keepalive_timeout               65;

    server_tokens                   off; # hide NGINX version


    #======================================================================================================================
    # Optimisations
    # See https://t37.net/nginx-optimization-understanding-sendfile-tcp_nodelay-and-tcp_nopush.html
    #======================================================================================================================

    sendfile                        on;
    tcp_nopush                      on;
    tcp_nodelay                     on;


    #======================================================================================================================
    # Logging
    # From https://github.com/just-containers/nginx-loadbalancer/blob/master/rootfs/etc/nginx/nginx.conf.tmpl
    #======================================================================================================================

    log_format                      main '$remote_addr - $remote_user [$time_local] "$request" '
                                         '$status $body_bytes_sent "$http_referer" '
                                         '"$http_user_agent" "$http_x_forwarded_for"';
    access_log                      <% bf-env NGINX_ACCESS_LOG %> main;


    #======================================================================================================================
    # Compression
    #======================================================================================================================

    gzip                            on;
    gzip_vary                       on;
    gzip_static                     on;
    gzip_proxied                    any;
    gzip_comp_level                 6;
    gzip_min_length                 256;
    gzip_buffers                    16 8k;
    gzip_http_version               1.1;
    gzip_types                      application/atom+xml application/javascript application/json application/rss+xml
                                    application/vnd.ms-fontobject application/x-font-opentype application/x-font-truetype
                                    application/x-font-ttf application/x-javascript application/xhtml+xml application/xml
                                    font/eot font/opentype font/otf font/truetype image/svg+xml image/vnd.microsoft.icon
                                    image/x-icon image/x-win-bitmap text/css text/javascript text/plain text/xml;

    brotli                          on;
    brotli_comp_level               6;
    brotli_min_length               256;
    brotli_static                   on;
    brotli_types                    application/atom+xml application/javascript application/json application/rss+xml
                                    application/vnd.ms-fontobject application/x-font-opentype application/x-font-truetype
                                    application/x-font-ttf application/x-javascript application/xhtml+xml application/xml
                                    font/eot font/opentype font/otf font/truetype image/svg+xml image/vnd.microsoft.icon
                                    image/x-icon image/x-win-bitmap text/css text/javascript text/plain text/xml;


    # zstd is only available on Alpine 3.20 and above - the directives are only added if the module is installed
    <% if apk info -e nginx-mod-http-zstd > /dev/null ; then -%>
    zstd                            on;
    zstd_comp_level                 3;
    zstd_min_length                 256;
    zstd_types                      application/atom+xml application/javascript application/json application/rss+xml
                                    application/vnd.ms-fontobject application/x-font-opentype application/x-font-truetype
                                    application/x-font-ttf application/x-javascript application/xhtml+xml application/xml
                                    font/eot font/opentype font/otf font/truetype image/svg+xml image/vnd.microsoft.icon
                                    image/x-icon image/x-win-bitmap text/css text/javascript text/plain text/xml;
    <% fi -%>


    #======================================================================================================================
    # Custom Server Configuration
    #======================================================================================================================

    include                         http.d/*.conf;


    #======================================================================================================================
    # Sites Configuration
    #======================================================================================================================

    include                         sites/*.conf;

}
