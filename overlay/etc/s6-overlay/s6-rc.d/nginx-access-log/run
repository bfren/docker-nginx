#!/usr/bin/nu

use bf
use bf-s6
bf env load

# Forward nginx access log to Docker
def main [
    name: string    # The service name, passed by s6-supervise
] {
    # set executable name - used to make log output more useful
    bf env x_set --override run $name

    # run checks before executing service
    if not (bf env check NGINX_FORWARD_ACCESS_LOG) {
        bf-s6 svc down $name
        return
    }

    # forward the log file to Docker
    bf-s6 log forward $name (bf env NGINX_ACCESS_LOG)
}
