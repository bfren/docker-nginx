#!/usr/bin/nu

use bf
use bf-nginx [conf]
use bf-s6
bf env load

# Start nginx as a foreground service
def main [
    name: string    # The service name, passed by s6-supervise
] {
    # set executable name - used to make log output more useful
    bf env x_set --override run $name

    # run checks before executing service
    conf test

    # flags:
    #   -g  set global configuration directive, in this case turn daemon mode off so it runs as a foreground service
    bf write "Starting nginx in foreground mode."
    let args = [
        "-g" "daemon off;"
    ]
    bf-s6 svc launch nginx ...$args
}
